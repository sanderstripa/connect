{
  "manifest_version": 3,
  "name": "Connect",
  "version": "0.1.4",
  "description": "Sudoku, Xray and Mist. Independent browser connection.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "proxy",
    "storage",
    "privacy",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Connect",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "assets/icon.png"
  }
}
